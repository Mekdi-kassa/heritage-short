# ==============================================================================
# The Heritage Short - Environment Credentials & API Configuration
# Copy this file to .env and insert your personal API keys.
# DO NOT commit .env to GitHub (protected by .gitignore).
# ==============================================================================

# Google AI Studio Gemini API Key (Gemini 3.8 Flash, Flash-Lite, Gemini TTS)
# Free Tier available in Ethiopia: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare Workers AI (FLUX.1 schnell / FLUX.2 klein)
# Daily free tier available: https://dash.cloudflare.com/
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Hugging Face Inference Token (Optional alternative for FLUX models)
HF_TOKEN=your_huggingface_token_here

# Kaggle Credentials (For remote batch Wan 2.2 and ACE-Step GPU runs)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key
